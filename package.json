{
  "name": "dsh-del-chat",
  "version": "0.2.9",
  "type": "module",
  "description": "Adds a “Delete archive” item to the DSH sidebar Session menu that permanently removes an archived Session's JSONL log, projection cache and Workspace record from disk.",
  "license": "MIT",
  "author": "SLZ2025",
  "homepage": "https://github.com/SLZ2025/dsh-del-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SLZ2025/dsh-del-chat.git"
  },
  "bugs": {
    "url": "https://github.com/SLZ2025/dsh-del-chat/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete",
    "purge",
    "archive"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "purge-core.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "test",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/purge-core.test.mjs && node test/host-routes.test.mjs && node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
